{
  "expo": {
    "name": "velio",
    "slug": "velio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.velio",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Velio uses your location to trace your run on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Velio keeps recording your route while your screen is locked during a run.",
        "NSMotionUsageDescription": "Velio uses motion data to count your steps and cadence."
      }
    },
    "android": {
      "package": "com.example.velio",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Velio uses your location to trace your run on the map.",
          "locationAlwaysAndWhenInUsePermission": "Velio keeps recording your route while your screen is locked during a run.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Velio uses motion data to count your steps and cadence."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      "expo-sharing"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "80450898-9d82-41d8-8632-5f9d313ba81d"
      }
    },
    "owner": "dev-jain"
  }
}
